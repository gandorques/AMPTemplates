Meta.DisplayName=Mount & Blade II: Bannerlord - Coop Dedicated Server
Meta.Description=Bannerlord Coop campaign dedicated server (Only Workshop Item)
Meta.OS=Windows, Linux
Meta.AarchSupport=Unknown
Meta.Arch=x86_64
Meta.Author=Custom AMP Template
Meta.URL=https://steamcommunity.com
Meta.DisplayImageSource=steam:261550
Meta.EndpointURIFormat=
Meta.ConfigManifest=bannerlord-coopconfig.json
Meta.MetaConfigManifest=bannerlord-coopmetaconfig.json
Meta.ConfigRoot=bannerlord-coop.kvp
Meta.MinAMPVersion=2.6.0.0
Meta.SpecificDockerImage=cubecoders/ampbase:wine-stable
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=SupportedOnWindows, RecommendedOnLinux
Meta.ContainerPolicyReason=The dedicated server is a Windows executable and is run with Wine on Linux.
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=["steamcmd"]
Meta.ExtraContainerPackages=["lib32gcc-s1", "lib32stdc++6", "libatomic1"]
Meta.ConfigReleaseState=NotSpecified
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ReleaseNotes=
Meta.BreakingReleaseNotes=
