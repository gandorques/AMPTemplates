Meta.Author=BomberPilot
Meta.Description=Bannerlord Coop Mod Server
Meta.DisplayImageSource=url:https://steamusercontent.com
Meta.DisplayName=Bannerlordcoop3
Meta.EndpointURIFormat=
Meta.OS=Windows, Linux
Meta.URL=https://steamcommunity.com
Meta.MinAMPVersion=2.8.0.4
Meta.ConfigManifest=bannerlordcoop3config.json
Meta.ConfigRoot=bannerlordcoop3.kvp
Meta.SpecificDockerImage=cubecoders/ampbase:wine
Meta.DockerRequired=False
Meta.DockerBaseReadOnly=False
Meta.ContainerPolicy=Supported
Meta.ContainerPolicyReason=
Meta.ExtraSetupStepsURI=
Meta.Prerequisites=[]
Meta.ExtraContainerPackages=[]
Meta.ConfigReleaseState=EarlyWorkInProgress
Meta.NoCommercialUsage=False
Meta.ConfigVersion=1
Meta.ReleaseNotes=
Meta.BreakingReleaseNotes=
Meta.AppConfigId=bc74da61-128a-4931-ba09-5431fae89921
Meta.ImportableExtensions=[]
Meta.AppIsMultiIPAware=False

App.AdminMethod=STDIO
App.ApplicationPort1=4200
App.ApplicationReadyMode=RCONConnected
App.BaseDirectory=./bannerlordcoop3/
App.CommandLineArgs={{$PlatformArgs}} +ip {{$ApplicationIPBinding}} +port {{$ApplicationPort1}} +queryport {{$ApplicationPort2}} +rconpassword "{{$RemoteAdminPassword}}" +maxusers {{$MaxUsers}} {{$FormattedArgs}}
App.LinuxCommandLineArgs="./DedicatedServer/BannerlordCoopServer.exe"
App.WindowsCommandLineArgs=
App.CommandLineParameterDelimiter=
App.CommandLineParameterFormat=-{0} "{1}"
App.DisplayName=Bannerlordcoop3
App.ExecutableLinux=/usr/bin/wine
App.ExecutableWin=/DedicatedServer/BannerlordCoopServer.exe
App.ExitMethod=String
App.ExitString=stop
App.HasReadableConsole=true
App.HasWritableConsole=true
App.RapidStartup=false
App.RootDir=./bannerlordcoop3/
App.UpdateSource=None
App.WorkingDir=bannerlordcoop3

Console.AppReadyRegex=^Server is ready.$
Console.ThrowawayMessageRegex=^(WARNING|ERROR): Shader.+$
Console.UserChatRegex=^(?<username>.+?): (?<message>.+)$
Console.UserJoinRegex=^User (?<username>.+?) \((?<userid>-?d+)\) connected from \[::ffff:(?<endpoint>.+?)\]$
Console.UserLeaveRegex=^User (?<username>.+?) \((?<userid>-?d+)\) disconnected\. Reason: (.+?)$
